# Address seen by the browser/extension. Root origin only, no /api suffix.
LOCAL_EXPORT_PUBLIC_URL=https://export.example.com
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOCAL_EXPORT_API_TOKEN=
# Reverse proxy on this host connects to 127.0.0.1:8765.
EXPORTER_BIND_IP=127.0.0.1
EXPORTER_PORT=8765
EXPORTER_IMAGE=ghcr.io/honestliu/chatgpt-exporter-server:latest
