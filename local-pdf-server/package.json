{
  "name": "chatgpt-exporter-local-renderer",
  "version": "4.0.0",
  "private": true,
  "description": "Local Chromium renderer; uses the existing Chrome installation",
  "dependencies": {
    "playwright-core": "1.58.2"
  },
  "scripts": {
    "verify": "node verify-web-runner.mjs && node verify-web-snapshot.mjs",
    "verify:browser": "node verify-divider-browser.mjs",
    "verify:headings": "node verify-heading-navigation.mjs",
    "verify:admin": "node verify-web-admin.mjs",
    "verify:deployment": "python3 verify-deployment.py"
  }
}
