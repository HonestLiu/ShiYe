{
  "manifest_version": 3,
  "name": "拾页 · 稍后读助手",
  "version": "1.10.0",
  "description": "收藏网页离线快照、划词高亮与阅读笔记；支持 ChatGPT 对话选择与原貌导出。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "pageCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "bootstrap.js",
        "snapshot-adapter.js",
        "capture.js",
        "core.js",
        "web-snapshot.js",
        "role-icons.js",
        "custom-select.js",
        "content-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "edge-bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "resources": [
        "content.css"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "webpage.css",
        "reading.css",
        "webpage-theme.css"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开拾页收藏面板"
    },
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "高亮当前网页选中文字"
    }
  }
}
